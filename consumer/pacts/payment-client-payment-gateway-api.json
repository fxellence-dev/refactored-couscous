{
  "consumer": {
    "name": "payment-client"
  },
  "interactions": [
    {
      "description": "a request to get settled payment status",
      "providerStates": [
        {
          "name": "a settled payment exists"
        }
      ],
      "request": {
        "matchingRules": {
          "path": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "/api/payments/txn_[a-z0-9\\-]+"
              }
            ]
          }
        },
        "method": "GET",
        "path": "/api/payments/txn_settled123"
      },
      "response": {
        "body": {
          "amount": 150,
          "authorizationCode": "AUTH-123456",
          "createdAt": "2025-12-05T10:00:00Z",
          "currency": "USD",
          "settlementId": "settle_abc123",
          "status": "SETTLED",
          "transactionId": "txn_settled123",
          "updatedAt": "2025-12-05T10:05:00Z"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.authorizationCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss'Z'",
                  "match": "datetime"
                }
              ]
            },
            "$.settlementId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.transactionId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.updatedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss'Z'",
                  "match": "datetime"
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 200
      }
    },
