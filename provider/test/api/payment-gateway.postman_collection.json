              "    pm.expect(jsonData.error).to.eql('VALIDATION_ERROR');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardNumber\": \"123\",\n  \"expiryMonth\": \"12\",\n  \"expiryYear\": \"2025\",\n  \"cvv\": \"123\",\n  \"amount\": 99.99,\n  \"currency\": \"USD\",\n  \"merchantId\": \"MERCH-12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/authorize",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "authorize"]
        }
      }
    },
    {
      "name": "Get Payment Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    var jsonData = pm.response.json();",
