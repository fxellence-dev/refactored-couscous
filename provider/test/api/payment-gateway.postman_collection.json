          "raw": "{{baseUrl}}/api/payments/txn_nonexistent",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "txn_nonexistent"]
        }
      }
    },
    {
      "name": "Settle Payment - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('transactionId');",
              "    pm.expect(jsonData).to.have.property('settlementId');",
              "    pm.expect(jsonData).to.have.property('status');",
              "    pm.expect(jsonData).to.have.property('amount');",
              "    pm.expect(jsonData).to.have.property('currency');",
              "    pm.expect(jsonData).to.have.property('timestamp');",
              "});",
              "",
              "pm.test(\"Status is SETTLED\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('SETTLED');",
              "});",
              "",
              "pm.test(\"Settlement ID is present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.settlementId).to.match(/^settle_/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"authorizationCode\": \"{{authorizationCode}}\",\n  \"amount\": 99.99,\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/settle",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "settle"]
        }
      }
    },
    {
      "name": "Settle Payment - Already Settled",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"Response has error\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('error');",
              "    pm.expect(jsonData.error).to.eql('ALREADY_SETTLED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"authorizationCode\": \"{{authorizationCode}}\",\n  \"amount\": 99.99,\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/settle",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "settle"]
        }
      }
    },
    {
      "name": "Refund Payment - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('transactionId');",
              "    pm.expect(jsonData).to.have.property('refundId');",
              "    pm.expect(jsonData).to.have.property('status');",
              "    pm.expect(jsonData).to.have.property('amount');",
              "    pm.expect(jsonData).to.have.property('currency');",
              "    pm.expect(jsonData).to.have.property('timestamp');",
              "});",
              "",
              "pm.test(\"Status is REFUNDED\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('REFUNDED');",
              "});",
              "",
              "pm.test(\"Refund ID is present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.refundId).to.match(/^refund_/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"amount\": 99.99,\n  \"currency\": \"USD\",\n  \"reason\": \"Customer requested refund\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/refund",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "refund"]
        }
      }
    },
