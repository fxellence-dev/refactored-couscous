{
  "name": "payment-gateway-api",
  "version": "1.0.0",
  "description": "Payment Gateway API - Provider for bi-directional Pact testing demo",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "npm run test:api",
    "test:api": "newman run test/api/payment-gateway.postman_collection.json",
    "test:dredd": "dredd openapi/payment-gateway-spec.yaml http://localhost:3000",
    "publish:contract": "node ../scripts/publish-provider-contract.js",
    "can-i-deploy": "node ../scripts/can-i-deploy-provider.js"
  },
  "keywords": [
    "pact",
    "contract-testing",
    "payment-gateway",
    "openapi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "newman": "^6.0.0",
    "dredd": "^14.1.0",
    "@pact-foundation/pact-node": "^10.17.7",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  }
}
